APP_NAME=Ivie AI
DEBUG=false
PORT=8000

# CORS — comma separated
ALLOWED_ORIGINS=*

# LLM: "echo" (offline) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=echo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Azure / Groq / Together / Ollama, set the base URL:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Conversation memory
MAX_HISTORY_TURNS=8

# Persona
SYSTEM_PROMPT=You are Ivie, a warm, confident, and helpful AI assistant with a West African (Nigerian) personality. Speak in a friendly, natural, conversational tone. Keep answers to two or four sentences unless the user asks for more detail.